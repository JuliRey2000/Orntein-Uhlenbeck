# Configuración opcional del laboratorio (copia este archivo como .env y ajústalo).
# Todas las variables llevan el prefijo MRLAB_ (ver backend/src/mrlab/config.py).
# Nada de esto llega al navegador. El archivo .env se lee desde la carpeta en la
# que se ejecuta el comando (normalmente, la raíz del repositorio), y las rutas
# relativas también se resuelven desde ella. Los valores por defecto (abajo,
# comentados) apuntan a las carpetas del repositorio.

# Carpetas de datos locales (ignoradas por git). Con Docker no se usan: el
# contenedor siempre trabaja en /app/data, montada desde ./data.
# MRLAB_DATA_DIR=data
# MRLAB_CACHE_DIR=data/cache
# MRLAB_STUDIES_DIR=data/studies
# MRLAB_UPLOADS_DIR=data/uploads

# Registro de proveedores de datos
# MRLAB_PROVIDERS_FILE=backend/providers.toml

# Yahoo Finance: reintentos tras el primer intento y espera base en segundos
# (esperas de 1, 2, 4 y 8 s). Los usan la API y examples/fetch_ko_pep.py.
# MRLAB_YAHOO_MAX_RETRIES=4
# MRLAB_YAHOO_BACKOFF_BASE_SECONDS=1.0

# API (fase 2)
# Orígenes del navegador autorizados (CORS), separados por comas: el servidor
# de desarrollo de Vite (5173) y la interfaz servida por nginx (8080).
# MRLAB_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# MRLAB_LOG_LEVEL=INFO
# Hilos para los cálculos en segundo plano (p. ej. /api/backtest/compare).
# Siguen dentro de un único proceso de uvicorn (decisión F1).
# MRLAB_JOB_WORKERS=2
# Tamaño máximo de un CSV o de un run_config.json subido, en MB (413 si se supera).
# MRLAB_MAX_UPLOAD_MB=10

# Solo docker-compose.yml: interfaz y puerto publicados en el equipo anfitrión
# (por defecto 127.0.0.1:8000, solo este equipo; la API no tiene autenticación),
# y uid/gid del usuario del contenedor (en Linux, el dueño de la carpeta ./data).
# MRLAB_BIND=127.0.0.1
# MRLAB_PORT=8000
# MRLAB_UID=1000
# MRLAB_GID=1000

# Versión del código que se registra en run_config.json. Si no se define, se
# usa `git rev-parse HEAD` (con "-dirty" si hay cambios sin confirmar). En
# Docker no hay carpeta .git: `make docker-up` la pasa al construir la imagen.
# No lleva el prefijo MRLAB_.
# GIT_COMMIT=

# Claves de API de futuros proveedores (p. ej. Tiingo): se leen en el backend.
# TIINGO_API_KEY=
